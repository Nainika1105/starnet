# Production environment for the STAR-Net API.
#
# Copy to your host's secret store (Fly secrets, Render env vars, a .env the
# host reads) -- do NOT commit a filled-in copy. The API refuses to start with
# STARNET_ENVIRONMENT=production unless the first three are set properly, so a
# misconfigured deployment fails at boot rather than quietly serving traffic
# anyone can sign into.

# Turns on the boot-time safety checks. Not a cosmetic label.
STARNET_ENVIRONMENT=production

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Anyone who knows this can mint a token for any account, including an admin.
# Rotating it invalidates every issued token, which is the point.
STARNET_JWT_SECRET=

# The dashboard's real origin, comma-separated if more than one. No wildcard.
STARNET_CORS_ORIGINS=https://starnet-admin.example.org

# Managed Postgres with the PostGIS extension available. The app runs
# CREATE EXTENSION IF NOT EXISTS postgis at startup, so the role needs rights
# to do that once (or an admin should create it ahead of time).
STARNET_DATABASE_URL=postgresql+psycopg://user:password@host:5432/starnet

# MUST stay false on anything reachable from the internet. The seed creates six
# accounts sharing the password published in the README, one of them an admin.
STARNET_SEED_ON_STARTUP=false

# Photo storage. "s3" is any S3-compatible store (AWS, Supabase Storage,
# Cloudflare R2, MinIO); objects are written private and served as presigned
# URLs. "local" is refused in production unless STARNET_MEDIA_ROOT is a
# genuinely persistent mounted disk -- on an ephemeral filesystem every photo
# is lost on redeploy, and the photos are the evidence the mechanism rests on.
STARNET_STORAGE_BACKEND=s3
STARNET_S3_BUCKET=starnet-photos
# For Supabase: https://<project-ref>.supabase.co/storage/v1/s3
# Leave empty for real AWS S3.
STARNET_S3_ENDPOINT_URL=
STARNET_S3_REGION=ap-south-1
STARNET_S3_ACCESS_KEY_ID=
STARNET_S3_SECRET_ACCESS_KEY=
# How long a presigned photo URL stays valid.
STARNET_S3_URL_TTL_SECONDS=3600

# Only used when STARNET_STORAGE_BACKEND=local.
# STARNET_MEDIA_ROOT=/media

# --- optional: mechanism tuning, all defaulted in config.py ---------------
# STARNET_CONFIDENCE_MODE=fusion
# STARNET_CLUSTERING_ENABLED=true
# STARNET_R0_BASE_POINTS=100
